{
  "name": "@shikkhaos/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "description": "ShikkhaOS desktop shell",
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "vitest": "2.1.9"
  },
  "author": "Petra Software Solution",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepare:app": "node scripts/build.mjs prepare",
    "dev": "npm run ensure:electron && node scripts/build.mjs prepare && electron dist/main.js",
    "package:linux": "node scripts/build.mjs package",
    "ensure:electron": "node ../node_modules/electron/install.js"
  }
}
