# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# ---------------------------------------------------------------- control plane (required)
# Runtime connection to the Petra control-plane database, as the restricted role petra_control_app.
CONTROL_DATABASE_URL=postgres://petra_control_app:CHANGE_ME_CONTROL_PASSWORD@127.0.0.1:5432/petra_control
# Owner connection used ONLY by `npm run control:migrate`.
CONTROL_MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/petra_control
# Password given to petra_control_app by `npm run control:setup` (must match CONTROL_DATABASE_URL).
CONTROL_APP_PASSWORD=CHANGE_ME_CONTROL_PASSWORD

# ---------------------------------------------------------------- credential encryption (required)
# base64 of 32 random bytes: `npm run petra -- generate-master-key`. Keep it in your secret manager,
# NOT in the database, NOT in the repository, NOT next to database backups.
PETRA_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
PETRA_MASTER_KEY_ID=k1
# During key rotation only: the previous key, so existing credentials stay readable until re-encrypted.
# PETRA_MASTER_KEY_PREVIOUS=
# PETRA_MASTER_KEY_PREVIOUS_ID=

# ---------------------------------------------------------------- operator tooling (NEVER give to the API process)
# Privileged connection (CREATEDB + CREATEROLE) to the maintenance database. Used by `npm run petra`.
PROVISIONER_DATABASE_URL=postgres://PROVISIONER_USER:PROVISIONER_PASSWORD@127.0.0.1:5432/postgres

# ---------------------------------------------------------------- legacy shared school database (migration/rollback only)
# Only needed while some school still has db_mode='shared' (Phase 1 layout).
# SHARED_DATABASE_URL=postgres://shikkha_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/shikkhaos_dev
# MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/shikkhaos_dev
# APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# ---------------------------------------------------------------- HTTP / sessions
# Comma-separated browser origins allowed to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
MAX_SESSIONS_PER_USER=5
# Defaults to true when NODE_ENV=production (required there).
# COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Empty = ignore X-Forwarded-*. A number = trusted proxy hop count (e.g. 1 behind one reverse proxy).
# Otherwise a comma-separated list of proxy IPs/CIDRs. Set this correctly when deployed behind a proxy.
TRUST_PROXY=

# ---------------------------------------------------------------- tenancy and subscriptions
MAX_SCHOOL_POOLS=25
SCHOOL_POOL_MAX=5
# true = TLS to school databases. Must be enabled and verified for any non-local deployment.
SCHOOL_DB_SSL=false
ENTITLEMENT_CACHE_SECONDS=10
BILLING_TIMEZONE=Asia/Dhaka
TRIAL_DAYS=30

# ---------------------------------------------------------------- development only
# `npm run petra -- seed-demo` (refused when NODE_ENV=production).
DEV_SEED_PASSWORD=CHANGE_ME_DEV_SEED_PASSWORD

# ---------------------------------------------------------------- automated tests (disposable databases; DROPPED and recreated each run)
TEST_CONTROL_DATABASE_URL=postgres://petra_control_app:CHANGE_ME_CONTROL_PASSWORD@127.0.0.1:5432/petra_control_test
TEST_CONTROL_MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/petra_control_test
TEST_PROVISIONER_DATABASE_URL=postgres://PROVISIONER_USER:PROVISIONER_PASSWORD@127.0.0.1:5432/postgres
# Legacy shared-mode tests (Phase 1 layout):
TEST_DATABASE_URL=postgres://shikkha_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/shikkhaos_test
TEST_MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/shikkhaos_test
