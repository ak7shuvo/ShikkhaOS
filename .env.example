# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# ---------------------------------------------------------------- control plane (required)
# Runtime connection to the Petra control-plane database, as the restricted role petra_control_app.
CONTROL_DATABASE_URL=postgres://petra_control_app:CHANGE_ME_CONTROL_PASSWORD@127.0.0.1:5432/petra_control
# Owner connection used ONLY by `npm run control:migrate`.
CONTROL_MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/petra_control
# Password given to petra_control_app by `npm run control:setup` (must match CONTROL_DATABASE_URL).
CONTROL_APP_PASSWORD=CHANGE_ME_CONTROL_PASSWORD

# ---------------------------------------------------------------- credential encryption (required)
# base64 of 32 random bytes: `npm run petra -- generate-master-key`. Keep it in your secret manager,
# NOT in the database, NOT in the repository, NOT next to database backups.
PETRA_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
PETRA_MASTER_KEY_ID=k1
# During key rotation only: the previous key, so existing credentials stay readable until re-encrypted.
# PETRA_MASTER_KEY_PREVIOUS=
# PETRA_MASTER_KEY_PREVIOUS_ID=

# ---------------------------------------------------------------- operator tooling (NEVER give to the API process)
# Privileged connection (CREATEDB + CREATEROLE) to the maintenance database. Used by `npm run petra`.
PROVISIONER_DATABASE_URL=postgres://PROVISIONER_USER:PROVISIONER_PASSWORD@127.0.0.1:5432/postgres

# ---------------------------------------------------------------- legacy shared school database (migration/rollback only)
# Only needed while some school still has db_mode='shared' (Phase 1 layout).
# SHARED_DATABASE_URL=postgres://shikkha_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/shikkhaos_dev
# MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/shikkhaos_dev
# APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# ---------------------------------------------------------------- HTTP / sessions
# Comma-separated browser origins allowed to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
MAX_SESSIONS_PER_USER=5
# Defaults to true when NODE_ENV=production (required there).
# COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
# Account-wide ceiling across all source addresses (distributed guessing); LOGIN_MAX_FAILURES is per address.
LOGIN_ACCOUNT_MAX_FAILURES=30
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Global per-IP request limit (also applies to /api/public/*, which additionally has its own 60/min cap).
API_RATE_LIMIT_PER_MINUTE=600
# Empty = ignore X-Forwarded-*. A number = trusted proxy hop count (e.g. 1 behind one reverse proxy).
# Otherwise a comma-separated list of proxy IPs/CIDRs. Set this correctly when deployed behind a proxy.
# REQUIRED in production (start-up fails if empty): a hop count 1-10, a list of proxy IPs/CIDRs, or `none` when the API is reached directly.
TRUST_PROXY=

# ---------------------------------------------------------------- tenancy and subscriptions
MAX_SCHOOL_POOLS=25
SCHOOL_POOL_MAX=5
# true = TLS to school databases. Must be enabled and verified for any non-local deployment.
# Must be true in production (verified TLS to school databases).
SCHOOL_DB_SSL=false
ENTITLEMENT_CACHE_SECONDS=10
BILLING_TIMEZONE=Asia/Dhaka
TRIAL_DAYS=30

# ---------------------------------------------------------------- first platform administrator
# Read ONLY by `npm run petra -- platform-admin-create` (run once, then remove from the environment).
# PLATFORM_ADMIN_EMAIL=ops@example.org
# PLATFORM_ADMIN_PASSWORD=CHANGE_ME_MIN_10_CHARS

# ---------------------------------------------------------------- development only
# `npm run petra -- seed-demo` (refused when NODE_ENV=production).
DEV_SEED_PASSWORD=CHANGE_ME_DEV_SEED_PASSWORD

# ---------------------------------------------------------------- automated tests (DESTRUCTIVE)
# The test setup drops and recreates schemas and drops per-school databases/roles. It refuses to run unless ALL hold:
#   - PETRA_TEST_CLUSTER=disposable and PETRA_TEST_CLUSTER_ID match a marker you created on a cluster used ONLY for tests;
#   - every TEST_* URL points at the same loopback host/port (or a host listed in PETRA_TEST_ALLOWED_HOSTS);
#   - database names are shikkhaos_test[_x] / petra_control_test[_x]; the provisioner URL uses database "postgres";
#   - the cluster contains database petra_disposable_test_cluster with table marker(cluster_id) holding that same id.
# Prepare once, on a NEW cluster (never your development cluster), as a superuser:
#   CREATE DATABASE petra_disposable_test_cluster;
#   \c petra_disposable_test_cluster
#   CREATE TABLE marker (cluster_id text NOT NULL);  INSERT INTO marker VALUES ('<the id below>');
# Cleanup only drops school databases/roles recorded in the TEST control registry and scratch databases recorded in the
# marker ledger; unregistered sk_* objects and unrelated databases/roles are never touched.
PETRA_TEST_CLUSTER=disposable
PETRA_TEST_CLUSTER_ID=CHANGE_ME_UNIQUE_CLUSTER_ID
# PETRA_TEST_ALLOWED_HOSTS=
TEST_PROVISIONER_DATABASE_URL=postgres://PROVISIONER_USER:PROVISIONER_PASSWORD@127.0.0.1:54329/postgres
TEST_CONTROL_DATABASE_URL=postgres://petra_control_app:CHANGE_ME_CONTROL_PASSWORD@127.0.0.1:54329/petra_control_test
TEST_CONTROL_MIGRATION_DATABASE_URL=postgres://PROVISIONER_USER:PROVISIONER_PASSWORD@127.0.0.1:54329/petra_control_test
# Legacy shared-mode tests (Phase 1 layout):
TEST_DATABASE_URL=postgres://shikkha_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:54329/shikkhaos_test
TEST_MIGRATION_DATABASE_URL=postgres://PROVISIONER_USER:PROVISIONER_PASSWORD@127.0.0.1:54329/shikkhaos_test

# ---------------------------------------------------------------- database TLS and access control (see docs/DATABASE_ISOLATION.md)
# true = verified TLS (certificate + host name) to the control-plane / shared database. SCHOOL_DB_SSL (above) does the same for school databases.
# Must be true in production. In production the runtime database URLs must not contain sslmode/ssl parameters;
# the privileged operator URLs (PROVISIONER_/MIGRATION_/CONTROL_MIGRATION_DATABASE_URL) must include sslmode=verify-full.
CONTROL_DB_SSL=false
# PEM file with the CA that signed the PostgreSQL server certificate (private CA). Applies to all API database pools.
# DB_SSL_CA_FILE=/etc/petra/db-ca.pem
# Operator tools (pg_dump/pg_restore use libpq): PGSSLMODE=verify-full and PGSSLROOTCERT=/etc/petra/db-ca.pem
# Roles that may connect to the `postgres` maintenance database in addition to the connecting provisioner (comma-separated).
# PETRA_OPERATOR_ROLES=
# Optional HMAC key for backup manifests: `npm run petra -- generate-signing-key`. Keep it OUTSIDE the backup storage.
# PETRA_BACKUP_SIGNING_KEY=

# ---------------------------------------------------------------- tests only (never needed in production)
# TLS integration tests run only when both are set (scripts/ci/gen-test-certs.sh creates throw-away material; the disposable server needs ssl=on).
# PETRA_TEST_TLS_CA=/path/to/ca.crt
# PETRA_TEST_TLS_UNTRUSTED_CA=/path/to/untrusted-ca.crt
