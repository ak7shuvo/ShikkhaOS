# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Runtime connection: the restricted role created by `npm run db:setup` (RLS is enforced for it).
DATABASE_URL=postgres://shikkha_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/shikkhaos_dev
# Owner connection, used ONLY by db:setup / db:migrate / db:seed / admin:create. Never used by the API.
MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/shikkhaos_dev
# Password given to the shikkha_app role by db:setup (must match DATABASE_URL).
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Comma-separated browser origins allowed to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
# Defaults to true when NODE_ENV=production (required there).
# COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Development seed only (npm run db:seed). Refused when NODE_ENV=production.
DEV_SEED_PASSWORD=CHANGE_ME_DEV_SEED_PASSWORD

# First platform administrator (npm run admin:create -w server).
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

# Automated tests (use a separate, disposable database; it is DROPPED and recreated each run).
TEST_DATABASE_URL=postgres://shikkha_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/shikkhaos_test
TEST_MIGRATION_DATABASE_URL=postgres://OWNER_USER:OWNER_PASSWORD@127.0.0.1:5432/shikkhaos_test
