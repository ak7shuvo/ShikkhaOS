{
  "name": "shikkhaos",
  "private": true,
  "version": "0.1.0",
  "description": "ShikkhaOS — School Management & Academic Information System",
  "workspaces": [
    "server",
    "web",
    "e2e",
    "desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "db:setup": "npm run db:setup -w server",
    "db:migrate": "npm run db:migrate -w server",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web && npm run typecheck -w e2e && npm run typecheck -w desktop",
    "test": "npm run test -w server && npm run test -w web && npm run test -w desktop",
    "build": "npm run build -w server && npm run build -w web",
    "control:setup": "npm run control:setup -w server",
    "control:migrate": "npm run control:migrate -w server",
    "petra": "npm run petra -w server --",
    "e2e": "npm run test -w e2e",
    "desktop:dev": "npm run dev -w desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^15.0.0"
  },
  "type": "module"
}
