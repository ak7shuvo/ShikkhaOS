{
  "name": "@shikkhaos/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=../.env src/scripts/db-setup.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/scripts/migrate.ts",
    "control:setup": "tsx --env-file-if-exists=../.env src/scripts/control-setup.ts",
    "control:migrate": "tsx --env-file-if-exists=../.env src/scripts/control-migrate.ts",
    "petra": "tsx --env-file-if-exists=../.env src/scripts/petra.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@node-rs/argon2": "^2.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
